const char* WIFI_SSID = "Motor123";
const char* WIFI_PASSWORD = "123456789";

const char* THINGSPEAK_API_KEY = "7V06CDBDJ98SRUBL";
const char* THINGSPEAK_URL = "http://api.thingspeak.com/update";

// =====================================================
// LCD
// =====================================================
LiquidCrystal lcd(13, 12, 14, 27, 26, 25);

// =====================================================
// ANALOG INPUTS
// =====================================================
#define VOLTAGE_POT_PIN       36
#define CURRENT_POT_PIN       39
#define BATTERY_VOLTAGE_PIN   34
#define ACS712_PIN            35

// =====================================================
// DIGITAL INPUTS AND OUTPUTS
// =====================================================
#define WATER_SENSOR_PIN 32
#define RELAY_PIN        5
#define BUZZER_PIN       33
#define VOICE_PIN        21

// =====================================================
// POT SIMULATION RANGES
// =====================================================
const float SIM_VOLTAGE_MIN = 180.0;
const float SIM_VOLTAGE_MAX = 280.0;

const float SIM_CURRENT_MIN = 0.0;
const float SIM_CURRENT_MAX = 15.0;

const float LOW_VOLTAGE_LIMIT  = 210.0;
const float HIGH_VOLTAGE_LIMIT = 250.0;

const float LOW_CURRENT_LIMIT  = 1.0;
const float HIGH_CURRENT_LIMIT = 8.0;

// =====================================================
// BATTERY PROTECTION
// =====================================================
const float BATTERY_LOW_LIMIT  = 10.5;
const float BATTERY_HIGH_LIMIT = 14.6;

const float VOLTAGE_DIVIDER_RATIO = 5.0;
const float VOLTAGE_CALIBRATION = 1.0;

// =====================================================
// ACS712 CALIBRATION
// =====================================================
const float ACS712_SENSITIVITY_MV_PER_A = 100.0 / 1.5;
const float CURRENT_CALIBRATION = 1.0;

// =====================================================
// TIMERS
// =====================================================
const unsigned long SENSOR_INTERVAL_MS = 250;
const unsigned long LCD_INTERVAL_MS = 1000;
const unsigned long THINGSPEAK_INTERVAL_MS = 20000;

const unsigned long WATER_CHECK_DELAY_MS = 5000;
const unsigned long VOICE_PULSE_MS = 500;

// =====================================================
// SENSOR VALUES
// =====================================================
float simulatedVoltage = 0.0;
float simulatedCurrent = 0.0;

float batteryVoltage = 0.0;
float pumpCurrent = 0.0;
float acsZeroMillivolts = 0.0;

bool waterAvailable = false;
bool pumpRunning = false;

int faultCode = 0;
String faultMessage = "NORMAL";

// =====================================================
// TIMER VARIABLES
// =====================================================
unsigned long lastSensorRead = 0;
unsigned long lastLCDUpdate = 0;
unsigned long lastThingSpeakUpload = 0;

unsigned long pumpStartTime = 0;
unsigned long voiceStartTime = 0;

bool lcdPage = false;
bool voicePulseActive = false;

int lastNotifiedFault = 0;

void SEND_SMS(String num, String str);

// =====================================================
// PUMP CONTROL
// =====================================================
void pumpOn()
{
  if (!pumpRunning)
  {
    digitalWrite(RELAY_PIN, HIGH);
    pumpRunning = true;

    // Start the 5-second water-check timer
    pumpStartTime = millis();


    Serial.println("PUMP ON");
    Serial.println("Water check will begin after 5 seconds.");
 
  }
}

void pumpOff()
{
  digitalWrite(RELAY_PIN, LOW);

  if (pumpRunning)
  {
    Serial.println("PUMP OFF");
  }

  pumpRunning = false;
  pumpStartTime = 0;
}



// =====================================================
// READ SIMULATED VOLTAGE
// =====================================================
float readSimulatedVoltage()
{
  int adcValue = analogRead(VOLTAGE_POT_PIN);
  float percentage = (float)adcValue / 4095.0;

  return SIM_VOLTAGE_MIN +
         percentage * (SIM_VOLTAGE_MAX - SIM_VOLTAGE_MIN);
}

// =====================================================
// READ SIMULATED CURRENT
// =====================================================
float readSimulatedCurrent()
{
  int adcValue = analogRead(CURRENT_POT_PIN);
  float percentage = (float)adcValue / 4095.0;

  return SIM_CURRENT_MIN +
         percentage * (SIM_CURRENT_MAX - SIM_CURRENT_MIN);
}

// =====================================================
// READ BATTERY VOLTAGE
// =====================================================
float readBatteryVoltage()
{
  const int samples = 30;
  uint32_t totalMilliVolts = 0;

  for (int i = 0; i < samples; i++)
  {
    totalMilliVolts += analogReadMilliVolts(BATTERY_VOLTAGE_PIN);
  }

  float adcMilliVolts = (float)totalMilliVolts / samples;
  float adcVoltage = adcMilliVolts / 1000.0;

  return adcVoltage *
         VOLTAGE_DIVIDER_RATIO *
         VOLTAGE_CALIBRATION;
}

// =====================================================
// CALIBRATE ACS712
// Pump remains OFF during calibration.
// =====================================================
void calibrateACS712()
{
  Serial.println("Calibrating ACS712...");
  Serial.println("Keep pump OFF during calibration.");

  uint32_t totalMilliVolts = 0;
  const int samples = 300;

  for (int i = 0; i < samples; i++)
  {
    totalMilliVolts += analogReadMilliVolts(ACS712_PIN);
    delay(3);
  }

  acsZeroMillivolts = (float)totalMilliVolts / samples;

  Serial.print("ACS712 zero point: ");
  Serial.print(acsZeroMillivolts, 1);
  Serial.println(" mV");
}

// =====================================================
// READ ACTUAL PUMP CURRENT
// MONITORING ONLY - NOT USED FOR PUMP CONTROL
// =====================================================
float readPumpCurrent()
{
  const int samples = 30;
  uint32_t totalMilliVolts = 0;

  for (int i = 0; i < samples; i++)
  {
    totalMilliVolts += analogReadMilliVolts(ACS712_PIN);
  }

  float measuredMilliVolts = (float)totalMilliVolts / samples;

  float difference = measuredMilliVolts - acsZeroMillivolts;

  float current = difference / ACS712_SENSITIVITY_MV_PER_A;

  current = fabsf(current);
  current *= CURRENT_CALIBRATION;

  if (current < 0.08)
  {
    current = 0.0;
  }

  return current;
}

// =====================================================
// WATER SENSOR
// HIGH = WATER AVAILABLE
// LOW  = WATER NOT AVAILABLE
// =====================================================
bool readWaterAvailability()
{
  return digitalRead(WATER_SENSOR_PIN) == HIGH;
}

// =====================================================
// SEND SMS ONLY WHEN A NEW FAULT OCCURS
// =====================================================
void notifyFault(int code)
{
  if (code == 0)
  {
    lastNotifiedFault = 0;
    return;
  }

  if (code == lastNotifiedFault)
  {
    return;
  }

  lastNotifiedFault = code;

  switch (code)
  {
    case 1:
      digitalWrite(VOICE_PIN, HIGH);
   
      SEND_SMS("+918431791338", "Under Voltage Detected.");
       delay(1000);
     digitalWrite(VOICE_PIN, LOW);
      break;

    case 2:
     digitalWrite(VOICE_PIN, HIGH);
      SEND_SMS("+918431791338", "Over Voltage Detected.");
       delay(1000);
     digitalWrite(VOICE_PIN, LOW);
      break;

    case 3:
    digitalWrite(VOICE_PIN, HIGH);
      SEND_SMS("+918431791338", "Under Current Detected.");
      delay(1000);
     digitalWrite(VOICE_PIN, LOW);
      break;

    case 4:
    digitalWrite(VOICE_PIN, HIGH);
      SEND_SMS("+918431791338", "Over Current Detected.");
      delay(1000);
     digitalWrite(VOICE_PIN, LOW);
      break;

    case 5:
    digitalWrite(VOICE_PIN, HIGH);
      SEND_SMS("+918431791338", "DRY RUN: No water detected after 5 seconds. Pump stopped.");
      delay(1000);
     digitalWrite(VOICE_PIN, LOW);
      break;

    case 6:
    digitalWrite(VOICE_PIN, HIGH);
      SEND_SMS("+918431791338", "Low Battery Detected.");
      delay(1000);
     digitalWrite(VOICE_PIN, LOW);
      break;

    case 7:
      SEND_SMS("+918431791338", "High Battery Voltage Detected.");
      break;
  }
}

// =====================================================
// PROTECTION CHECK
// Water sensor is checked for pump protection only
// after the pump has been running for 5 seconds.
// =====================================================
void checkProtection()
{
  faultCode = 0;
  faultMessage = "NORMAL";

  // 1. Simulated supply voltage protection
  if (simulatedVoltage < LOW_VOLTAGE_LIMIT)
  {
    faultCode = 1;
    faultMessage = "UNDER VOLTAGE";
  }
  else if (simulatedVoltage > HIGH_VOLTAGE_LIMIT)
  {
    faultCode = 2;
    faultMessage = "OVER VOLTAGE";
  }

  // 2. Simulated current protection
  else if (simulatedCurrent < LOW_CURRENT_LIMIT)
  {
    faultCode = 3;
    faultMessage = "UNDER CURRENT";
  }
  else if (simulatedCurrent > HIGH_CURRENT_LIMIT)
  {
    faultCode = 4;
    faultMessage = "OVER CURRENT";
  }

  // 3. Actual battery voltage protection
  else if (batteryVoltage < BATTERY_LOW_LIMIT)
  {
    faultCode = 6;
    faultMessage = "BATTERY LOW";
  }
  else if (batteryVoltage > BATTERY_HIGH_LIMIT)
  {
    faultCode = 7;
    faultMessage = "BATTERY HIGH";
  }

  // 4. DELAYED WATER / DRY-RUN PROTECTION
  // Do not reject the initial pump start because of water.
  // After 5 seconds, water must be available.
  else if (pumpRunning &&
           millis() - pumpStartTime >= WATER_CHECK_DELAY_MS &&
           !waterAvailable)
  {
    faultCode = 5;
    faultMessage = "DRY RUN";
  }

  // 5. Apply protection
  if (faultCode == 0)
  {
    digitalWrite(BUZZER_PIN, LOW);

    // Start pump only if other protection conditions are OK.
    // Water will be checked 5 seconds after this start.
    if (!pumpRunning)
    {
      pumpOn();
    }

    lastNotifiedFault = 0;
  }
  else
  {
    pumpOff();
    digitalWrite(BUZZER_PIN, HIGH);
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print(faultMessage);
    lcd.setCursor(0, 1);
    lcd.print("Detected...");
    delay(1000);
    notifyFault(faultCode);
  }
}

// =====================================================
// LCD DISPLAY
// Page 1: Simulated voltage and current
// Page 2: Battery voltage and pump current
// =====================================================
void updateLCD()
{
  lcd.clear();

  if (!lcdPage)
  {
    lcd.setCursor(0, 0);
    lcd.print("POT V:");
    lcd.print(simulatedVoltage, 1);
    lcd.print("V");

    lcd.setCursor(0, 1);
    lcd.print("POT I:");
    lcd.print(simulatedCurrent, 1);
    lcd.print("A");
  }
  else
  {
    lcd.setCursor(0, 0);
    lcd.print("BAT:");
    lcd.print(batteryVoltage, 1);
    lcd.print("V P:");
    lcd.print(pumpRunning ? "ON" : "OFF");

    lcd.setCursor(0, 1);
    lcd.print("PUMP I:");
    lcd.print(pumpCurrent, 2);
    lcd.print("A");
  }

  lcdPage = !lcdPage;
}

// =====================================================
// THINGSPEAK UPLOAD
// Field 1 = Simulated voltage
// Field 2 = Simulated current
// Field 3 = Battery voltage
// Field 4 = Actual pump current
// =====================================================
void uploadThingSpeak()
{
  if (WiFi.status() != WL_CONNECTED)
  {
    Serial.println("ThingSpeak skipped: WiFi disconnected.");
    return;
  }

  HTTPClient http;

  String url = String(THINGSPEAK_URL);
  url += "?api_key=";
  url += THINGSPEAK_API_KEY;

  url += "&field1=" + String(simulatedVoltage, 2);
  url += "&field2=" + String(simulatedCurrent, 2);
  url += "&field3=" + String(batteryVoltage, 2);
  url += "&field4=" + String(pumpCurrent, 2);

  http.setConnectTimeout(2000);
  http.setTimeout(2000);

  if (http.begin(url))
  {
    int httpCode = http.GET();

    if (httpCode > 0)
    {
      Serial.print("ThingSpeak response: ");
      Serial.println(httpCode);

      Serial.print("Entry response: ");
      Serial.println(http.getString());
    }
    else
    {
      Serial.print("ThingSpeak error: ");
      Serial.println(http.errorToString(httpCode));
    }

    http.end();
  }
}

// =====================================================
// SERIAL MONITOR
// =====================================================
void printSerialData()
{
  Serial.println("--------------------------------");

  Serial.print("POT Voltage: ");
  Serial.print(simulatedVoltage, 2);
  Serial.println(" V");

  Serial.print("POT Current: ");
  Serial.print(simulatedCurrent, 2);
  Serial.println(" A");

  Serial.print("Battery Voltage: ");
  Serial.print(batteryVoltage, 2);
  Serial.println(" V");

  Serial.print("Actual Pump Current: ");
  Serial.print(pumpCurrent, 2);
  Serial.println(" A");

  Serial.print("Water Available: ");
  Serial.println(waterAvailable ? "YES" : "NO");

  Serial.print("Pump: ");
  Serial.println(pumpRunning ? "ON" : "OFF");

  if (pumpRunning)
  {
    unsigned long elapsed = millis() - pumpStartTime;

    if (elapsed < WATER_CHECK_DELAY_MS)
    {
      Serial.print("Water check in: ");
      Serial.print((WATER_CHECK_DELAY_MS - elapsed + 999) / 1000);
      Serial.println(" seconds");
    }
    else
    {
      Serial.println("Water protection: ACTIVE");
    }
  }

  Serial.print("Fault: ");
  Serial.println(faultMessage);

  Serial.print("Fault Code: ");
  Serial.println(faultCode);
}

// =====================================================
// SETUP
// =====================================================
void setup()
{
  Serial.begin(9600);
  Serial2.begin(9600);

  pinMode(RELAY_PIN, OUTPUT);
  pinMode(BUZZER_PIN, OUTPUT);
  pinMode(VOICE_PIN, OUTPUT);
 digitalWrite(VOICE_PIN, LOW);
  pumpOff();
  digitalWrite(BUZZER_PIN, LOW);

  pinMode(WATER_SENSOR_PIN, INPUT_PULLUP);

  analogReadResolution(12);

  analogSetPinAttenuation(VOLTAGE_POT_PIN, ADC_11db);
  analogSetPinAttenuation(CURRENT_POT_PIN, ADC_11db);
  analogSetPinAttenuation(BATTERY_VOLTAGE_PIN, ADC_11db);
  analogSetPinAttenuation(ACS712_PIN, ADC_11db);

  lcd.begin(16, 2);
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("AGRI PROTECTION");
  lcd.setCursor(0, 1);
  lcd.print("Starting...");

  calibrateACS712();

  // WiFi connection
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Connecting WiFi");

  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  unsigned long wifiStart = millis();

  while (WiFi.status() != WL_CONNECTED &&
         millis() - wifiStart < 10000)
  {
    delay(250);
  }

  lcd.clear();

  if (WiFi.status() == WL_CONNECTED)
  {
    Serial.print("WiFi connected. IP: ");
    Serial.println(WiFi.localIP());

    lcd.setCursor(0, 0);
    lcd.print("WiFi Connected");
  }
  else
  {
    Serial.println("WiFi not connected.");

    lcd.setCursor(0, 0);
    lcd.print("WiFi Offline");
  }

  delay(1000);

  // Initial readings
  simulatedVoltage = readSimulatedVoltage();
  simulatedCurrent = readSimulatedCurrent();
  batteryVoltage = readBatteryVoltage();
  pumpCurrent = readPumpCurrent();
  waterAvailable = readWaterAvailability();

  // Pump can start if the electrical and battery
  // protection conditions are satisfied. Water is
  // evaluated after the 5-second startup period.
  checkProtection();

  lastSensorRead = millis();
  lastLCDUpdate = millis();
  lastThingSpeakUpload = millis();

  Serial.println("Agriculture protection system started.");

  SEND_SMS("+918431791338", "Agriculture protection system started.");
}

// =====================================================
// MAIN LOOP
// =====================================================
void loop()
{
  unsigned long now = millis();

  // Keep voice trigger pulse short
//  updateVoice();

  // Sensor monitoring
  if (now - lastSensorRead >= SENSOR_INTERVAL_MS)
  {
    lastSensorRead = now;

    simulatedVoltage = readSimulatedVoltage();
    simulatedCurrent = readSimulatedCurrent();

    batteryVoltage = readBatteryVoltage();
    pumpCurrent = readPumpCurrent();

    waterAvailable = readWaterAvailability();

    checkProtection();

    printSerialData();
  }

  // LCD refresh
  if (now - lastLCDUpdate >= LCD_INTERVAL_MS)
  {
    lastLCDUpdate = now;
    updateLCD();
  }

  // ThingSpeak upload
  if (now - lastThingSpeakUpload >= THINGSPEAK_INTERVAL_MS)
  {
    lastThingSpeakUpload = now;
    uploadThingSpeak();
  }
}

// =====================================================
// GSM SMS FUNCTION
// =====================================================
void SEND_SMS(String num, String str)
{
  Serial2.println("AT+CMGF=1");
  delay(1000);

  Serial2.print("AT+CMGS=\"");
  Serial2.print(num);
  Serial2.println("\"");
  delay(1000);

  Serial2.println(str);
  delay(100);

  Serial2.write(26);
  delay(1000);

  Serial.println("SMS command sent.");
}
